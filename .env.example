# ==============================================================================
# OmniScope OSINT - Environment Configuration Template
# ==============================================================================
# All keys in this file are OPTIONAL.
# STRICT ZERO-FAKE POLICY:
# If a key is left empty or omitted, that provider will be cleanly omitted from
# the user interface and backend polling. No mock/dummy data will be generated.
# ==============================================================================

# 1. NVIDIA NIM (Neural AI Reasoning & Forecast Models)
# Free tier (1,000 credits): https://build.nvidia.com/
NVIDIA_NIM_KEY=

# 2. OpenSky Network (Live ADS-B Flight Transponder Feeds)
# Free community account: https://opensky-network.org/
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# 3. Tomorrow.io (Hyper-local Microclimate & Air Quality)
# Free API plan: https://www.tomorrow.io/
TOMORROW_API_KEY=

# 4. NASA FIRMS (VIP Satellite Wildfire Hotspot Feeds)
# Free Map Key: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=

# 5. AirNow EPA (US Official Air Quality Index)
# Free API key: https://docs.airnowapi.org/
AIRNOW_API_KEY=

# 6. OpenRouteService (Geocoding & Matrix Routing)
# Free token: https://openrouteservice.org/
OPENROUTESERVICE_KEY=

# 7. Mapbox (Optional Satellite Vector Tiles - Default is free Esri Satellite)
# Free token: https://www.mapbox.com/
MAPBOX_TOKEN=
